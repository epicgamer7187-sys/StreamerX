# Fill these in Railway -> Variables (do NOT commit a real .env)
BOT_TOKEN=
BOT_NAME=StreamerX
CLIENT_ID=
# comma-separated Discord user IDs of YOU (the owner)
OWNER_IDS=
SUPPORT_SERVER=
DEFAULT_PREFIX=.
# 32+ random characters, generate with: openssl rand -hex 32
ENCRYPTION_KEY=
# Railway: add a Volume mounted at /data so users.json/config.json survive redeploys
DATA_DIR=/data
# page = headless tab capture, x11 = Xvfb + ffmpeg (no page audio). Page mode auto-falls back to x11 if it fails.
CAPTURE_MODE=page
CAPTURE_FALLBACK=true
STREAM_WIDTH=1280
STREAM_HEIGHT=720
STREAM_FPS=30
STREAM_BITRATE_KBPS=2500
STREAM_AUDIO=true
CHROME_BIN=/usr/bin/chromium
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
